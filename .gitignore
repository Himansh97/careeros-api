.venv/
__pycache__/
*.pyc
*.db
# SQLite's write-ahead sidecars. `*.db` does not match them, and the -wal file
# holds recent writes to the applications table — candidate data, which
# non-negotiable #3 keeps out of git. One `git add -A` was all it would take.
*.db-shm
*.db-wal
*.db-journal
.env
# Any copy of it too. A rename-and-restore left one behind once, and a
# bare `.env` pattern does not match `.env.backup-20260815-144759`.
.env.*
.claude/
.DS_Store

# Per-job override and evidence-import scripts must not embed resume content.
# Overrides are resume text derived from career_evidence.json, which the careeros
# repo gitignores as personal data — inlining it in Python routed around that.
# The data now lives in ~/careeros/overrides/*.json and scripts/apply_overrides.py
# reads it. These patterns stop a one-off from quietly reintroducing the problem.
scripts/align_*.py
scripts/import_*.py
# ...but a source importer embeds no candidate data — it reads a feed and writes
# jobs. The rule above is about resume text, not the word "import".
!scripts/import_ziprecruiter.py

# Ruflo local secrets and runtime data
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/

# --- ruflo runtime state (npx ruflo init) ---
# Local orchestration scaffolding and its databases. Ignored rather than
# committed so adopting or dropping ruflo never shows up as a repo change.
.claude-flow/
.agents/
.swarm/
ruvector.db
.mcp.json
